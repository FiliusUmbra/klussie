---
import { APP_URL } from "../data/services.js";
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="logo">klussie</a>
    <nav class="nav">
      <a href="/hoe-het-werkt">Hoe het werkt</a>
      <a href="/diensten/schilderwerken">Diensten</a>
      <a href="/vakman-worden">Word vakman</a>
    </nav>
    <a href={APP_URL} class="btn-primary header-cta">Vraag een offerte aan</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    gap: 16px;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    text-decoration: none;
    color: var(--forest);
  }
  .nav {
    display: flex;
    gap: 24px;
    flex: 1;
    justify-content: center;
  }
  .nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 14.5px;
    font-weight: 500;
  }
  .nav a:hover { color: var(--forest); }
  .header-cta { font-size: 13.5px; padding: 10px 18px; white-space: nowrap; }
  @media (max-width: 700px) {
    .nav { display: none; }
  }
</style>
