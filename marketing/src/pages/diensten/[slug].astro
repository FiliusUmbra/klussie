---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, APP_URL } from "../../data/services.js";

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const related = services.filter((s) => s.category === service.category && s.slug !== service.slug).slice(0, 4);
---
<BaseLayout
  path={`/diensten/${service.slug}`}
  title={service.name}
  description={service.blurb}
>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">{service.category}</div>
      <h1>{service.name}</h1>
      {service.certifiedOnly && <span class="badge cert-badge">Enkel erkende specialisten</span>}
      <p class="lead">{service.intro}</p>

      <div class="card reasons-card">
        <h2>Waarom via klussie?</h2>
        <ul>
          {service.reasons.map((r) => <li>{r}</li>)}
        </ul>
      </div>

      <a href={APP_URL} class="btn-primary">Vraag een offerte aan voor {service.name}</a>

      {related.length > 0 && (
        <div class="related">
          <h2 class="related-title">Ook interessant</h2>
          <div class="service-links">
            {related.map((s) => (
              <a href={`/diensten/${s.slug}`} class="service-chip">{s.name}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: 32px; margin: 6px 0 12px; }
  .cert-badge { margin-bottom: 16px; }
  .lead { font-size: 16px; color: var(--ink-soft); line-height: 1.6; max-width: 620px; margin-bottom: 28px; }
  .reasons-card { max-width: 620px; margin-bottom: 28px; }
  .reasons-card h2 { font-size: 17px; margin-bottom: 12px; }
  .reasons-card ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .reasons-card li { font-size: 14.5px; color: var(--ink-soft); line-height: 1.5; }
  .related { margin-top: 48px; }
  .related-title { font-size: 18px; margin-bottom: 12px; }
  .service-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .service-chip {
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    padding: 8px 14px; font-size: 13.5px; text-decoration: none; color: var(--ink);
  }
  .service-chip:hover { border-color: var(--forest); color: var(--forest); }
</style>
