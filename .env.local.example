# Copy to .env.local and fill in the values for the environment you intend
# to use. .env.local is gitignored and holds real keys — never commit it.
#
# Switching between staging and production is changing these two values and
# restarting the dev server. There is no environment name in the code, and
# none should ever be added.
#
# Where to get the values, and the staging provisioning runbook:
# docs/operations/ENVIRONMENTS.md

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
